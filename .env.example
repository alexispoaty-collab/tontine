# --- Prisma CLI (npm run db:sql / db:diff) — valeurs dans hPanel > Bases de données
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/NOM_BASE"

# --- Application (adaptateur MariaDB) — mêmes valeurs, champ par champ
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Better Auth
BETTER_AUTH_SECRET=          # openssl rand -hex 32
BETTER_AUTH_URL=https://ton-domaine.com

# --- Cron hPanel (étape 4)
CRON_SECRET_KEY=             # openssl rand -hex 32
